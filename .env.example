# =============================================================================
# Rapid X AI Voice Agent - environment configuration
# Copy this file to `.env` and fill in real values.
# =============================================================================

# ----- LiveKit (cloud project) -----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ----- Gemini Live (Google) -----
# Either GEMINI_API_KEY or GOOGLE_API_KEY is fine.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Voices: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
GEMINI_VOICE=Puck
GEMINI_TEMPERATURE=0.8

# ----- SIP provider (Twilio / Vobiz / Telnyx / Plivo / ...) -----
SIP_TRUNK_ID=
SIP_DOMAIN=
SIP_USERNAME=
SIP_PASSWORD=
SIP_OUTBOUND_NUMBER=

# Backward-compat: legacy VOBIZ_* names are still honored if you have an old setup.
VOBIZ_SIP_TRUNK_ID=
VOBIZ_SIP_DOMAIN=
VOBIZ_USERNAME=
VOBIZ_PASSWORD=
VOBIZ_OUTBOUND_NUMBER=

# Optional default transfer destination for the `transfer_call` tool.
DEFAULT_TRANSFER_NUMBER=

# Optional Supabase persistence (call logs / recordings).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=call-recordings

# Dashboard (Next.js)
PORT=3000
HOST=0.0.0.0
AGENT_NAME=outbound-caller
